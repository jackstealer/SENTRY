# Copy to .env and fill in. Never commit .env.
# Blank values mean "not configured"; the app runs without the later-phase ones.

ENV=dev
USER_ID=me
USER_NAME=
USER_TZ=Asia/Kolkata
DATABASE_URL=postgresql+asyncpg://sentry:sentry@127.0.0.1:5432/sentry
API_HOST=127.0.0.1
API_PORT=8000

# OpenAI: model names live here only, never in code
OPENAI_API_KEY=
# blank = api.openai.com; or an OpenAI-compatible API, e.g. https://api.groq.com/openai/v1
OPENAI_BASE_URL=
OPENAI_MODEL_REASONING=
OPENAI_MODEL_FAST=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMS=1536
# comma-separated, tried in order after retries on the primary model fail (Phase 3)
OPENAI_MODEL_FALLBACKS=
# USD per 1M tokens for the llm_usage cost estimate, e.g. some-model=0.15/0.60,other-model=2/8
OPENAI_PRICES=

# Phase 5 (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Phase 6 (Google Calendar). Keep both files outside the repo.
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_TOKEN_FILE=
GOOGLE_SENTRY_CALENDAR_ID=

PERSONA_HONORIFIC=sir
DASHBOARD_TOKEN=

# Phase 7 (desktop agent)
ACTIVITY_POLL_SECONDS=5
ACTIVITY_IDLE_SECONDS=120
ACTIVITY_STORE_TITLES=false

# Phase 9+ (leave blank until then)
AGENT_SHARED_SECRET=
TTS_VOICE=
SEARCH_PROVIDER=
SEARCH_API_KEY=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

LOG_LEVEL=INFO
